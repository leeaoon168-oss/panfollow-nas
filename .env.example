# ============================================================================
# 复制成 .env 后**逐项填自己的**，下面的值全部留空，不要照抄示例
#     cp .env.example .env && vi .env
# ============================================================================

# ===== 追更清单（必填）=====
# 你的 kdocs 文档或表格地址，形如：
#   https://www.kdocs.cn/l/xxxxxxxx
#   https://www.kdocs.cn/l/xxxxxxxx   （表格也是这个形式）
DOC_URL=

# 推荐留空，启动后用 http://<NAS_IP>:8099/login 扫码登录
# （Cookie 会存到 /state，自动续期，不用手填）
# 只有扫码不可用时才手填：浏览器 F12 → Network → 任一 kdocs 请求 → 复制整段 Cookie
DOC_COOKIE=

# ===== Alist（用来取百度分享直链）=====
# 填你 NAS 上 Alist 的地址，容器访问宿主机要用局域网 IP，不要写 127.0.0.1
#   形如 http://192.168.1.100:5244
ALIST_URL=
ALIST_USER=
ALIST_PASS=
# 让 Alist 代理下载，避免 aria2 拿到裸直链 403（一般保持 1）
ALIST_WEB_PROXY=1

# ===== 百度 =====
# 浏览器 Cookie 里 BDUSS= 后面那一段
ALIST_BDUSS=
# 转存必须用 STOKEN（同样在 Cookie 里找）
ALIST_STOKEN=

# ===== aria2 =====
# aria2 的 RPC 密钥：改成你自己的一串随机字符（不能留空，否则 aria2 起不来）
ARIA2_SECRET=change-me-please
# ARIA2_RPC=http://aria2:6800/jsonrpc

# ===== 调度与路径 =====
# 每隔多少小时刷新清单并同步一次
SYNC_HOURS=24
# 1 = 自动下载，0 = 只检查不下载
AUTO_SYNC=0
# 容器内下载目录（和 compose 里的挂载对应，一般不用改）
DOWNLOAD_DIR=/downloads

# ===== 宿主机路径（必填，按你自己的 NAS 改）=====
# 下载文件最终落在宿主机哪个目录
DOWNLOAD_HOST_DIR=
# 挂进容器的数据卷根目录（App 里要能浏览/切换下载目录就需要它）
DATA_HOST_DIR=
